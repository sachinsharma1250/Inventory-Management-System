rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Check if the request is from the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function: Retrieve user profile document
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function: Check if user has manager role
    function isManager() {
      return isAuthenticated() && (
        request.auth.token.role == "manager" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == "manager")
      );
    }

    // Warehouses: only authenticated users read; only role == "manager" write
    match /warehouses/{warehouseId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // Locations: only authenticated users read; only role == "manager" write
    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }

    match /categories/{categoryId} {
      allow read, write: if isAuthenticated();
    }

    match /stock_levels/{stockLevelId} {
      allow read, write: if isAuthenticated();
    }

    match /receipts/{receiptId} {
      allow read, write: if isAuthenticated();
    }

    match /deliveries/{deliveryId} {
      allow read, write: if isAuthenticated();
    }

    match /transfers/{transferId} {
      allow read, write: if isAuthenticated();
    }

    match /adjustments/{adjustmentId} {
      allow read, write: if isAuthenticated();
    }

    match /stock_ledger/{ledgerId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Users: role defaults to "staff" on creation, only managers may escalate roles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && (
        request.resource.data.role == "staff" || isManager()
      );
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
        isManager()
      );
      allow delete: if isManager();
    }
  }
}
